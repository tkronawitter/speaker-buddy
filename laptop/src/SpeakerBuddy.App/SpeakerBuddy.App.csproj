<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Tray application without a console window (A-03); console modes attach to the caller's console -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the Ubuntu CI runner build this Windows-only project; it is not run there -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- The LibraryImport source generator for the Win32 serial line calls emits unsafe code -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>speaker-buddy</AssemblyName>
    <RootNamespace>SpeakerBuddy.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpeakerBuddy.Core\SpeakerBuddy.Core.csproj" />
  </ItemGroup>

</Project>
