<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Tray application without a console window (A-03); console modes attach to the caller's console -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the Ubuntu CI runner build this Windows-only project; it is not run there -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- The LibraryImport source generator for the Win32 serial line calls emits unsafe code -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>speaker-buddy</AssemblyName>
    <RootNamespace>SpeakerBuddy.App</RootNamespace>
    <!-- The informational version is the git describe of the build (target below), not 1.0.0+<sha> -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Logo D, generated by tools/make-icons.ps1 -->
    <ApplicationIcon>..\..\..\assets\logo\speaker-buddy.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Tray icons: normal while the timer is connected, waiting otherwise (TrayContext) -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\assets\logo\speaker-buddy.ico" LogicalName="speaker-buddy.ico" />
    <EmbeddedResource Include="..\..\..\assets\logo\speaker-buddy-waiting.ico" LogicalName="speaker-buddy-waiting.ico" />
  </ItemGroup>

  <!-- Same form as the firmware: v0.1.0, v0.1.0-3-gabc1234, with -dirty for uncommitted changes -->
  <Target Name="SetVersionFromGit" BeforeTargets="GetAssemblyVersion">
    <Exec Command="git describe --tags --always --dirty" WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="low"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitDescribe" />
      <Output TaskParameter="ExitCode" PropertyName="GitDescribeExitCode" />
    </Exec>
    <PropertyGroup>
      <InformationalVersion Condition="'$(GitDescribeExitCode)' == '0' And '$(GitDescribe)' != ''">$(GitDescribe)</InformationalVersion>
      <InformationalVersion Condition="'$(InformationalVersion)' == '' Or '$(GitDescribeExitCode)' != '0'">unknown</InformationalVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpeakerBuddy.Core\SpeakerBuddy.Core.csproj" />
  </ItemGroup>

</Project>
