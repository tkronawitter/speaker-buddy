# Waveshare ESP32-S3-Touch-AMOLED-1.8 (V2): 16 MB QIO flash, 8 MB octal PSRAM
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Own partition table: one factory app, no OTA (A-04)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Console and protocol share the built-in USB Serial/JTAG port (S-01)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# No radio (A-04). Bluetooth is off here. CONFIG_ESP_WIFI_ENABLED has no prompt in IDF v5.5 and
# cannot be switched off; the application never initialises Wi-Fi, and tools/check-image detects
# linked Wi-Fi, Bluetooth, OTA or TinyUSB code by symbol names and radio archive members.
CONFIG_BT_ENABLED=n

# LVGL
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
